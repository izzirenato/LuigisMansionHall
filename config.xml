				<Texture file="assets/textures/IMG3.png"/>
			</Material>

			
			<!-- Batch_8SG già definito sopra con IMG7.png -->
			
			<Material name="Standard_Surface2SG" type="phong">
				<Texture file="assets/textures/gold.jpg"/>
			</Material>

			<Material name="Standard_Surface1SG" type="phong">
				<Texture file="assets/textures/pearl.jpg"/>
			</Material>
			<!-- Materiali per boo -->
			<Material name="Mesh0SG" type="lambert">
				<Texture file="assets/textures/Texture3.png"/>
			</Material>
			<Material name="Mesh1SG" type="lambert">
				<Texture file="assets/textures/Texture0.png"/>
			</Material>
			<Material name="Mesh2SG" type="lambert">
				<Texture file="assets/textures/Texture1.png"/>
