			<!-- Materiale generico -->
			
		</Materials>

		<!-- Oggetti dinamici -->
		<Objects>
			<Object name="Boo" type="dynamic">
				<Model path="assets/models/boo.obj"/>
				<Textures>
					<Texture slot="0" file="assets/textures/Texture0.png"/>
					<Texture slot="1" file="assets/textures/Texture1.png"/>
					<Texture slot="2" file="assets/textures/Texture2.png"/>
					<Texture slot="3" file="assets/textures/Texture3.png"/>
					<Texture slot="4" file="assets/textures/Texture4.png"/>
					<Texture slot="5" file="assets/textures/Texture5.png"/>
				</Textures>
				<Position x="0" y="0" z="0"/>
				<Scale x="1" y="1" z="1"/>
				<Rotation x="0" y="0" z="0"/>
				<Behavior>
					<Follow target="camera"/>
					<Offset x="0" y="0" z="-2"/>
				</Behavior>
			</Object>
			
			<!-- Porta rimossa - ora caricata dal main come woodModel -->
		</Objects>
	</Scene>

	<Settings>
		<Window>
			<Width>1920</Width>
			<Height>1080</Height>
			<Title>Luigi's Mansion Hall</Title>
			<Fullscreen>false</Fullscreen>
		</Window>

		<Controls>
			<MouseSensitivity>0.1</MouseSensitivity>
			<MovementSpeed>15.0</MovementSpeed>
		</Controls>

		<Graphics>
			<VSync>true</VSync>
			<MSAA>4</MSAA>
		</Graphics>
	</Settings>
</LuigisMansionHall>