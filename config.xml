<?xml version="1.0" encoding="utf-8"?>
<LuigisMansionHall>
	<Scene>
		<Camera>
			<Position x="0" y="0" z="0"/>
			<Target x="0" y="0" z="-1"/>
			<FOV>60</FOV>
			<Speed>15</Speed>
		</Camera>

		

		<Lighting>
			<!-- Luce ambientale -->
			<AmbientLight r="0.06" g="0.06" b="0.07"/>
			<!--<AmbientLight r="0.12" g="0.12" b="0.14"/>-->
			
			<!-- Luce direzionale principale (luna fredda) -->
			<DirectionalLight name="MoonLight" enabled="true">
				<Direction x="-0.3" y="-1.0" z="-0.1"/>
				<Color r="0.8" g="0.9" b="1.1"/>
				<!--<Color r="3.2" g="3.6" b="4.4"/>-->
			</DirectionalLight>

			<!-- Luci dei candelabri - 6 candele blu -->
			<PointLight name="Candelabra_Right1" enabled="true">
				<Position x="15.40" y="8.15" z="1.13"/>
				<Color r="0.8" g="1.2" b="3.6"/>
				<Constant>1.0</Constant>
				<Linear>0.16</Linear>
				<Quadratic>0.07</Quadratic>
			</PointLight>

			<PointLight name="Candelabra_Right2" enabled="true">
				<Position x="16.10" y="8.0" z="1.13"/>
				<Color r="0.8" g="1.2" b="3.6"/>
				<Constant>1.0</Constant>
				<Linear>0.16</Linear>
				<Quadratic>0.07</Quadratic>
			</PointLight>

			<PointLight name="Candelabra_Right3" enabled="true">
				<Position x="14.50" y="8.1" z="1.13"/>
				<Color r="0.8" g="1.2" b="3.6"/>
				<Constant>1.0</Constant>
				<Linear>0.16</Linear>
				<Quadratic>0.07</Quadratic>
			</PointLight>

			<PointLight name="Candelabra_Left1" enabled="true">
				<Position x="-14.90" y="8.15" z="1.13"/>
				<Color r="0.8" g="1.2" b="3.6"/>
				<Constant>1.0</Constant>
				<Linear>0.16</Linear>
				<Quadratic>0.07</Quadratic>
			</PointLight>

			<PointLight name="Candelabra_Left2" enabled="true">
				<Position x="-15.66" y="8.0" z="1.09"/>
				<Color r="0.8" g="1.2" b="3.6"/>
				<Constant>1.0</Constant>
				<Linear>0.16</Linear>
				<Quadratic>0.07</Quadratic>
			</PointLight>

			<PointLight name="Candelabra_Left3" enabled="true">
				<Position x="-13.90" y="7.85" z="1.09"/>
				<Color r="0.8" g="1.2" b="3.6"/>
				<Constant>1.0</Constant>
				<Linear>0.16</Linear>
				<Quadratic>0.07</Quadratic>
			</PointLight>
			
			<PointLight name="Candelabro_Centrale" enabled="true">
				<Position x="0" y="17" z="9.7"/>
				<Color r="3" g="3" b="10.0"/>  
				<Constant>1.0</Constant>
				<Linear>0.16</Linear>
				<Quadratic>0.07</Quadratic>
			</PointLight>

			<!-- Luce dinamica della camera (con effetto respiro) -->
			<PointLight name="CameraLight" enabled="true" dynamic="true">
				<Position x="0" y="0" z="0"/>
				<Color r="4.0" g="4.5" b="4.5"/>  
				<Constant>1.0</Constant>
				<Linear>1.2</Linear>              
				<Quadratic>0.1</Quadratic>       
				<BreathingEffect enabled="true" speed="1.2" minIntensity="0.8" maxIntensity="1.4"/>
			</PointLight>

			<!-- Luce del Boo (attivata quando Boo è presente) -->
			<PointLight name="BooLight" enabled="true" dynamic="true">
				<Position x="0" y="0" z="0"/>
				<Color r="4.0" g="4.5" b="4.5"/>
				<Constant>1.0</Constant>
				<Linear>1.2</Linear>
				<Quadratic>0.1</Quadratic>
				<BreathingEffect enabled="true" speed="1.2" minIntensity="0.8" maxIntensity="1.4"/>
			</PointLight>

			<!-- Skybox per illuminazione ambientale IBL -->
			<Skybox>
				<Type>procedural_night</Type> <!-- Generato proceduralmente -->
				<IBLStrength>0.25</IBLStrength>
				<AmbientStrength>0.5</AmbientStrength>
			</Skybox>
		</Lighting>

		<Materials>
			<!-- Materiali con tipi predefiniti -->
